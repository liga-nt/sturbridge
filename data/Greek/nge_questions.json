      "level": "intro",
      "year": 2025,
      "title": "Nauplios tricks the Greek fleet",
      "lines": [
        { "num": 1, "greek": "ὁ Ναύπλιος ἐθέλει δίκην λαμβάνειν," },
        { "num": 2, "greek": "διότι οἱ κύριοι τῶν Ἑλλήνων λύουσι τὸν υἱὸν αὐτοῦ ἐν τῷ πολέμῳ τῆς Τροίας." },
        { "num": 3, "greek": "ὅτε τὰ τῶν Ἑλλήνων πλοῖα οἴκαδε πλεῖ," },
        { "num": 4, "greek": "ὁ Ναύπλιος πείθει τὴν Ἀθήναν τὴν θύελλαν πέμπειν." },
        { "num": 5, "greek": "ὁ Ναύπλιος πρὸς τὰς πέτρας τὸν πυρσὸν φέρει," },
        { "num": 6, "greek": "ὥστε τὰ πλοῖα τῶν κυρίων αἵ μακραὶ πέτραι λύουσιν." }
      ],
      "glosses": {
        "δίκην λαμβάνειν": "to take vengeance",
        "διότι": "because",
        "αὐτοῦ": "his",
        "ὅτε": "when",
        "οἴκαδε": "homeward",
        "τὸ πλοῖον": "the ship",
        "ἡ θύελλα": "storm",
        "ἡ πέτρα": "the rock",
        "ὁ πυρσός": "the fire signal",
        "ὥστε": "so that"
      }
    }
  ],
