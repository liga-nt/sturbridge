rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Character reference images — dev only
    match /greek/characters/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.role == 'dev';
    }

    // Lesson images (chapter illustrations) — dev writes, authenticated reads
    match /greek/lessons/{lessonId}/{file} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.role == 'dev';
    }

    // Lesson audio — CF writes via Admin SDK (bypasses rules); authenticated reads
    match /greek/lessons/{lessonId}/{file=**} {
      allow read: if request.auth != null;
    }

  }
}
