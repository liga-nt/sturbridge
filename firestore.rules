rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function role()     { return request.auth.token.role; }
    function schoolId() { return request.auth.token.schoolId; }

    function isTeacher() { return role() == 'teacher'; }
    function isAdmin()   { return role() == 'admin'; }
    function isDev()     { return role() == 'dev'; }
    function isPriv()    { return isAdmin() || isDev(); }
    function isAuth()    { return request.auth != null; }

    // ── schools — dev reads/writes all; others read own school only ──────────
    match /schools/{sid} {
      allow read:  if isDev() || (isAuth() && schoolId() == sid);
      allow write: if isDev();
    }

    // ── courses — global config; anyone authenticated reads; dev writes ───────
    match /courses/{courseId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── standards — anyone authenticated reads; dev writes ───────────────────
    match /standards/{standardId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── tips — anyone authenticated reads; dev writes ────────────────────────
    match /tips/{itemId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── users ────────────────────────────────────────────────────────────────
    // - Anyone in the same school can read user docs (teachers need student names)
    // - Users can write their own doc; admin can write same-school users; dev all
    match /users/{uid} {
      allow read: if isDev()
                  || (isAuth() && request.auth.uid == uid)
                  || (isAuth() && resource.data.schoolId == schoolId());
      allow write: if isDev()
                   || (isAuth() && request.auth.uid == uid)
                   || (isAdmin() && resource.data.schoolId == schoolId());
    }

    // ── classes ──────────────────────────────────────────────────────────────
    // - Read: same school (teacher, student, admin all need it)
    // - Write: dev always; admin for same school; teacher for own classIds
    match /classes/{classId} {
      allow read: if isDev()
                  || (isAuth() && resource.data.schoolId == schoolId());
      allow write: if isDev()
                   || (isAdmin() && request.resource.data.schoolId == schoolId())
                   || (isTeacher() && request.auth.token.classIds.hasAny([classId]));
    }

    // ── invites ───────────────────────────────────────────────────────────────
    // Admin writes invites for their school; dev writes any.
    // Reads also limited to admin/dev (activation uses Admin SDK, bypasses rules).
    match /invites/{email} {
      allow read:  if isPriv();
      allow write: if isDev()
                   || (isAdmin() && request.resource.data.schoolId == schoolId());
    }

    // ── studentProgress ───────────────────────────────────────────────────────
    // Students own their top doc and sub-docs.
    // Teachers and admins from the same school can read (needed for mastery grid).
    // School check: look up the student's user doc to verify same school.
    match /studentProgress/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read: if isDev()
                  || ((isTeacher() || isAdmin())
                      && get(/databases/$(database)/documents/users/$(uid)).data.schoolId == schoolId());

      match /standards/{standardId} {
        allow read, write: if isAuth() && request.auth.uid == uid;
        allow read: if isDev()
                    || ((isTeacher() || isAdmin())
                        && get(/databases/$(database)/documents/users/$(uid)).data.schoolId == schoolId());
      }
    }

    // ── assignments — teacher writes own class; same-school reads ─────────────
    match /assignments/{classId} {
      allow read: if isDev()
                  || (isAuth()
                      && get(/databases/$(database)/documents/classes/$(classId)).data.schoolId == schoolId());
      allow write: if isDev()
                   || (isTeacher() && request.auth.token.classIds.hasAny([classId]));
    }

    // ── responses — students write own; teacher/admin/dev read ───────────────
    match /responses/{responseId} {
      allow create: if isAuth() && request.resource.data.studentId == request.auth.uid;
      allow read:   if isTeacher() || isPriv();
    }

    // ── question variants / templates (dev content management) ───────────────
    match /questionVariants/{variantId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    match /questionTemplates/{itemId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── leaderboards — any authenticated user reads; students/teachers write ──
    match /leaderboards/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── prompts (AI generation feature) ──────────────────────────────────────
    match /prompts/{promptId} {
      allow read, write: if isDev();
    }
  }
}
