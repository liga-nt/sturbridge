rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function role()     { return request.auth.token.role; }
    function schoolId() { return request.auth.token.schoolId; }

    function isTeacher() { return role() == 'teacher'; }
    function isAdmin()   { return role() == 'admin'; }
    function isDev()     { return role() == 'dev'; }
    function isPriv()    { return isAdmin() || isDev(); }
    function isAuth()    { return request.auth != null; }

    // ── schools — dev reads/writes all; others read own school only ──────────
    match /schools/{sid} {
      allow read:  if isDev() || (isAuth() && schoolId() == sid);
      allow write: if isDev();
    }

    // ── courses — global config; anyone authenticated reads; dev writes ───────
    match /courses/{courseId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── standards — anyone authenticated reads; dev writes ───────────────────
    match /standards/{standardId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── tips — anyone authenticated reads; dev writes ────────────────────────
    match /tips/{itemId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── users ────────────────────────────────────────────────────────────────
    // - Anyone in the same school can read user docs (teachers need student names)
    // - Users can write their own doc; admin can write same-school users; dev all
    match /users/{uid} {
      allow read: if isDev()
                  || (isAuth() && request.auth.uid == uid)
                  || (isAuth() && resource.data.schoolId == schoolId());
      allow write: if isDev()
                   || (isAuth() && request.auth.uid == uid)
                   || (isAdmin() && resource.data.schoolId == schoolId());
    }

    // ── classes ──────────────────────────────────────────────────────────────
    // - Read: same school (teacher, student, admin all need it)
    // - Create/update: dev always; admin for same school; teacher for own classIds
    // - Delete: dev always; admin for same school (split out because
    //   request.resource is null on delete, so it can't be checked the same
    //   way as create/update)
    match /classes/{classId} {
      allow read: if isDev()
                  || (isAuth() && resource.data.schoolId == schoolId());
      allow create, update: if isDev()
                             || (isAdmin() && request.resource.data.schoolId == schoolId())
                             || (isTeacher() && request.auth.token.classIds.hasAny([classId]));
      allow delete: if isDev()
                    || (isAdmin() && resource.data.schoolId == schoolId());
    }

    // ── invites ───────────────────────────────────────────────────────────────
    // Admin writes invites for their school; dev writes any.
    // Reads also limited to admin/dev (activation uses Admin SDK, bypasses rules).
    match /invites/{email} {
      allow read:  if isPriv();
      allow write: if isDev()
                   || (isAdmin() && request.resource.data.schoolId == schoolId());
    }

    // ── studentProgress ───────────────────────────────────────────────────────
    // Students own their top doc and sub-docs.
    // Teachers and admins from the same school can read (needed for mastery grid).
    // School check: look up the student's user doc to verify same school.
    match /studentProgress/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read: if isDev()
                  || ((isTeacher() || isAdmin())
                      && get(/databases/$(database)/documents/users/$(uid)).data.schoolId == schoolId());
      allow write: if isDev();

      match /standards/{standardId} {
        allow read, write: if isAuth() && request.auth.uid == uid;
        allow read: if isDev()
                    || ((isTeacher() || isAdmin())
                        && get(/databases/$(database)/documents/users/$(uid)).data.schoolId == schoolId());
        allow write: if isDev();
      }

      match /variantHistory/{historyId} {
        allow read, write: if isAuth() && request.auth.uid == uid;
        allow read: if isDev()
                    || ((isTeacher() || isAdmin())
                        && get(/databases/$(database)/documents/users/$(uid)).data.schoolId == schoolId());
        allow write: if isDev();
      }
    }

    // ── quizzes — teacher builds/owns for their class; same-school reads ─────
    match /quizzes/{quizId} {
      allow read: if isDev()
                  || (isAuth() && resource.data.schoolId == schoolId());
      allow write: if isDev()
                   || (isTeacher()
                       && request.resource.data.schoolId == schoolId()
                       && request.auth.token.classIds.hasAny([request.resource.data.classId]));

      match /versions/{versionId} {
        allow read: if isDev()
                    || (isAuth()
                        && get(/databases/$(database)/documents/quizzes/$(quizId)).data.schoolId == schoolId());
        allow write: if isDev()
                     || (isTeacher()
                         && request.auth.token.classIds.hasAny(
                              [get(/databases/$(database)/documents/quizzes/$(quizId)).data.classId]));
      }
    }

    // ── quizAssignments — one assign event; teacher writes own class; same-school reads ─
    match /quizAssignments/{assignmentId} {
      allow read: if isDev()
                  || (isAuth() && resource.data.schoolId == schoolId());
      allow create: if isDev()
                    || (isTeacher()
                        && request.resource.data.schoolId == schoolId()
                        && request.auth.token.classIds.hasAny([request.resource.data.classId]));
      allow update: if isDev()
                    || (isTeacher() && request.auth.token.classIds.hasAny([resource.data.classId]));
      allow delete: if isDev()
                    || (isTeacher() && request.auth.token.classIds.hasAny([resource.data.classId]));
    }

    // ── quizProgress — student owns their own doc; teacher/admin same-school read+write (freeze on end) ─
    match /quizProgress/{progressId} {
      allow create: if isAuth() && request.resource.data.studentId == request.auth.uid;
      // resource == null (doc not created yet) must be allowed through here —
      // getOrCreateQuizProgress's first getDoc() is on a doc that doesn't
      // exist yet, and resource.data on a null resource denies the whole
      // rule rather than just this clause, even for the doc's future owner.
      allow read: if isAuth() && (resource == null || resource.data.studentId == request.auth.uid);
      allow update: if isAuth() && resource.data.studentId == request.auth.uid;
      allow read: if isDev()
                  || ((isTeacher() || isAdmin()) && resource.data.schoolId == schoolId());
      allow write: if isDev()
                   || ((isTeacher() || isAdmin())
                       && resource.data.schoolId == schoolId()
                       && request.auth.token.classIds.hasAny([resource.data.classId]));
    }

    // ── sessions — students write own and read own; teacher/admin read same-school classes ─
    match /sessions/{sessionId} {
      allow create: if isDev()
                    || (isAuth() && request.resource.data.studentId == request.auth.uid);
      // update: same student re-flushing their own doc through a visit (writeSessionLog
      // reuses sessionId and re-writes repeatedly, not just once at page exit).
      allow read, update: if isDev()
                          || (isAuth() && resource.data.studentId == request.auth.uid);
      allow read: if isDev()
                  || ((isTeacher() || isAdmin())
                      && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.schoolId == schoolId());
    }

    // ── question variants / templates (dev content management) ───────────────
    match /questionVariants/{variantId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    match /questionTemplates/{itemId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── aligned audio cache (content-hash keyed, dev/script-generated) ────────
    match /audioSegments/{hash} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── leaderboards — any authenticated user reads; students/teachers write ──
    match /leaderboards/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ── prompts (AI generation feature) ──────────────────────────────────────
    match /prompts/{promptId} {
      allow read, write: if isDev();
    }

    // ── Greek vocab FSRS card states ─────────────────────────────────────────
    // Students own their card states; dev can read all.
    match /greekCardStates/{uid}/courses/{courseId}/cards/{cardId} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read: if isDev();
    }

    // ── Persian poem FSRS card states ────────────────────────────────────────
    // Students own their card states; dev can read all.
    match /persianCardStates/{uid}/poems/{poemId}/cards/{cardId} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read: if isDev();
    }

    // ── Persian review log — students append; dev reads ───────────────────────
    match /persianReviewLog/{docId} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read:   if isDev();
    }

    // ── Greek immersive course ────────────────────────────────────────────────
    match /story_bible/{docId} {
      allow read, write: if isDev();
    }

    match /lessons/{lessonId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── word_glosses — glossed Greek word forms for each course ──────────────
    match /word_glosses/{courseId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── NGE quiz question bank — dev-authored, student-readable ──────────────
    match /greek_questions/{docId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    match /greek_passage_quizzes/{docId} {
      allow read:  if isAuth();
      allow write: if isDev();
    }

    // ── bugReports — testers file their own; dev reads/triages ──────────────
    match /bugReports/{reportId} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isDev();
    }
  }
}
